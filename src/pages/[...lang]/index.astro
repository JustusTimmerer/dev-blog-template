---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Rail from '../../components/Rail.astro';
import PostCard from '../../components/PostCard.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, getSeries, getSeriesPosts, seriesUrl } from '../../lib/posts';
import { formatDate, localeStaticPaths, t, type Lang } from '../../lib/i18n';

export const getStaticPaths = localeStaticPaths;

const { lang } = Astro.props as { lang: Lang };
const ui = t(lang);
const posts = await getPosts(lang);
const featured = posts.filter((p) => p.entry.data.featured);
const lead = featured[0] ?? posts[0];
const side = featured[1] ?? posts.find((p) => p !== lead);
const shown = new Set([lead, side]);
const latest = posts.filter((p) => !shown.has(p)).slice(0, 6);

const featuredSeries = await Promise.all(
  (await getSeries(lang))
    .filter((s) => s.entry.data.featured)
    .map(async (s) => {
      const parts = await getSeriesPosts(lang, s.key);
      return { series: s, parts: parts.length, last: parts.at(-1) };
    }),
);
---

<BaseLayout lang={lang}>
  <div class="home">
    <Rail lang={lang} />
    <div>
      {lead && (
        <div class="lead-grid">
          <PostCard lang={lang} post={lead} size="lead" />
          {side && <PostCard lang={lang} post={side} />}
        </div>
      )}

      {featuredSeries.length > 0 && (
        <section>
          <h2 class="section-title">{ui.series}</h2>
          <div class="series-grid">
            {featuredSeries.map(({ series, parts, last }) => (
              <a class="series-card" href={seriesUrl(lang, series.key)}>
                <span class="label">{ui.parts(parts)} · {ui[series.entry.data.status]}</span>
                <h3>{series.entry.data.title}</h3>
                <p>{series.entry.data.description}</p>
                {last && <span class="label">{ui.latestPart}: {formatDate(last.entry.data.date, lang)}</span>}
              </a>
            ))}
          </div>
        </section>
      )}

      {latest.length > 0 && (
        <section>
          <h2 class="section-title">{ui.latest}</h2>
          <PostList lang={lang} posts={latest} />
        </section>
      )}
    </div>
  </div>
</BaseLayout>
