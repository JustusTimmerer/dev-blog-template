---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/PostList.astro';
import { getPosts, tagUrl } from '../../../lib/posts';
import { localeStaticPaths, t, type Lang } from '../../../lib/i18n';

export const getStaticPaths = localeStaticPaths;

const { lang } = Astro.props as { lang: Lang };
const ui = t(lang);
const posts = await getPosts(lang);
const tags = [...new Set(posts.flatMap((p) => p.entry.data.tags))].sort();
---

<BaseLayout lang={lang} title={ui.navBlog}>
  <header class="page-head">
    <span class="label">{ui.navBlog}</span>
    <h1>{ui.allPosts}</h1>
    <p>{ui.allPostsLede}</p>
  </header>
  {tags.length > 0 && (
    <ul class="chips" aria-label={ui.topics}>
      {tags.map((tag) => <li><a href={tagUrl(lang, tag)}>{tag}</a></li>)}
    </ul>
  )}
  <PostList lang={lang} posts={posts} />
</BaseLayout>
