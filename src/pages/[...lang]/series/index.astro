---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getSeries, getSeriesPosts, seriesUrl } from '../../../lib/posts';
import { formatDate, localeStaticPaths, t, type Lang } from '../../../lib/i18n';

export const getStaticPaths = localeStaticPaths;

const { lang } = Astro.props as { lang: Lang };
const ui = t(lang);
const series = await Promise.all(
  (await getSeries(lang)).map(async (s) => {
    const parts = await getSeriesPosts(lang, s.key);
    return { series: s, parts: parts.length, last: parts.at(-1) };
  }),
);
---

<BaseLayout lang={lang} title={ui.series}>
  <header class="page-head">
    <span class="label">{ui.series}</span>
    <h1>{ui.seriesHeading}</h1>
    <p>{ui.seriesLede}</p>
  </header>
  <div class="series-grid">
    {series.map(({ series: s, parts, last }) => (
      <a class="series-card" href={seriesUrl(lang, s.key)}>
        <span class="label">{ui.parts(parts)} · {ui[s.entry.data.status]}</span>
        <h3>{s.entry.data.title}</h3>
        <p>{s.entry.data.description}</p>
        {last && <span class="label">{ui.latestPart}: {formatDate(last.entry.data.date, lang)}</span>}
      </a>
    ))}
  </div>
</BaseLayout>
