---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../lib/i18n';

const en = t('en');
const de = t('de');
---

<BaseLayout lang="en" title={en.notFound} noAlternates noindex>
  <header class="page-head">
    <span class="label">404</span>
    <h1>{en.notFound}</h1>
    <p><a href="/">{en.backHome}</a></p>
    <p lang="de"><a href="/de/">{de.notFound}. {de.backHome}</a></p>
  </header>
</BaseLayout>
