---
import { t, url, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
---

<form class="contact-form" action="/contact.php" method="post" data-contact-form
  data-sending={ui.contactSending} data-success={ui.contactSuccess}
  data-error={ui.contactError} data-invalid={ui.contactInvalid}
  data-limited={ui.contactLimited} data-uncertain={ui.contactUncertain}>
  <div class="contact-fields">
    <label>
      <span>{ui.contactName}</span>
      <input name="name" autocomplete="name" maxlength="100" />
    </label>
    <label>
      <span>{ui.contactEmail}</span>
      <input name="email" type="email" autocomplete="email" maxlength="254" required />
    </label>
  </div>
  <label>
    <span>{ui.contactMessage}</span>
    <textarea name="message" rows="8" maxlength="5000" required></textarea>
  </label>
  <div class="contact-trap" aria-hidden="true" inert>
    <label>Website <input name="website" tabindex="-1" autocomplete="off" /></label>
  </div>
  <p class="contact-privacy">{ui.contactPrivacy} <a href={url(lang, '/privacy/')}>{ui.privacy}</a>.</p>
  <div class="contact-actions">
    <button type="submit" disabled>{ui.contactSend}</button>
    <p class="contact-status" role="status" aria-live="polite" aria-atomic="true"></p>
  </div>
  <noscript><p>{ui.contactJavascript}</p></noscript>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const status = form.querySelector<HTMLElement>('[role="status"]')!;
    const idleLabel = button.textContent;
    button.disabled = false;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (button.disabled || !form.reportValidity()) return;
      button.disabled = true;
      button.textContent = form.dataset.sending!;
      form.setAttribute('aria-busy', 'true');
      status.textContent = '';
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 20000);
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json', 'X-Contact-Form': '1' },
          body: new URLSearchParams(new FormData(form) as Iterable<[string, string]>),
          credentials: 'omit',
          signal: controller.signal,
        });
        // Apache may reject a request before PHP runs and return HTML, not JSON.
        if (response.status === 429) {
          status.textContent = form.dataset.limited!;
        } else if (response.status === 422 || response.status === 413) {
          status.textContent = form.dataset.invalid!;
        } else if (!response.ok) {
          status.textContent = form.dataset.error!;
        } else {
          const result = await response.json();
          if (result.ok === true) {
            form.reset();
            status.textContent = form.dataset.success!;
          } else {
            status.textContent = form.dataset.error!;
          }
        }
      } catch {
        // A lost response does not prove that the server failed to send the message.
        status.textContent = form.dataset.uncertain!;
      } finally {
        clearTimeout(timeout);
        button.disabled = false;
        button.textContent = idleLabel;
        form.removeAttribute('aria-busy');
      }
    });
  });
</script>

<style>
  .contact-form { max-width: var(--prose); margin: 0 auto; }
  .contact-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  label { display: grid; gap: 8px; margin-bottom: 24px; font-size: 14px; font-weight: 500; }
  input, textarea { width: 100%; min-width: 0; padding: 12px; border: 1px solid var(--ink-soft); border-radius: 4px; background: var(--bg); color: var(--ink); font: inherit; font-size: 16px; font-weight: 400; }
  textarea { resize: vertical; min-height: 160px; }
  input:focus-visible, textarea:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .contact-privacy { font-size: 14px; color: var(--ink-soft); }
  .contact-privacy a { color: var(--accent); }
  .contact-actions { display: flex; align-items: flex-start; gap: 20px; margin-top: 24px; }
  button { flex-shrink: 0; padding: 12px 18px; border: 1px solid var(--accent); border-radius: 4px; background: var(--accent); color: var(--bg); font: 600 14px var(--sans); cursor: pointer; }
  button:disabled { opacity: 0.6; cursor: wait; }
  .contact-status { margin: 10px 0 0; font-size: 14px; }
  .contact-trap { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  @media (max-width: 600px) {
    .contact-fields { grid-template-columns: 1fr; gap: 0; }
    .contact-actions { flex-direction: column; gap: 8px; }
  }
</style>
